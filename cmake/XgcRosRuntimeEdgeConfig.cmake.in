@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(XgcRuntimeSDK CONFIG REQUIRED)
find_dependency(catkin REQUIRED COMPONENTS roscpp)
include(${CMAKE_CURRENT_LIST_DIR}/XgcRosRuntimeEdgeEdgeTargets.cmake)
set(XgcRosRuntimeEdge_Edge_FOUND TRUE)
foreach(component IN LISTS XgcRosRuntimeEdge_FIND_COMPONENTS)
  if(component STREQUAL "Transport")
    find_dependency(XgcRoboticsInterfaces CONFIG REQUIRED)
    include(${CMAKE_CURRENT_LIST_DIR}/XgcRosRuntimeEdgeTransportTargets.cmake)
    set(XgcRosRuntimeEdge_Transport_FOUND TRUE)
  elseif(NOT component STREQUAL "Edge")
    set(XgcRosRuntimeEdge_${component}_FOUND FALSE)
  endif()
endforeach()
check_required_components(XgcRosRuntimeEdge)
